# Config for both the host (main.ts) and the sandbox.
# Copy this file to .env (gitignored) and fill in real values.

# GitHub fine-grained PAT, scoped to THIS repo only.
# Required permissions: Issues (R/W), Pull requests (R/W), Contents (R/W),
# Metadata (R). NOT: Workflows, Administration, Secrets, Packages, anything
# cross-repo. Create at: https://github.com/settings/personal-access-tokens/new
GH_TOKEN=

# Claude auth — pick ONE of the two below, not both. API_KEY supersedes OAUTH_TOKEN.
# Option A: subscription OAuth token.
CLAUDE_CODE_OAUTH_TOKEN=
# Option B: Anthropic API key.
ANTHROPIC_API_KEY=

# Slug for the PRD this agent run targets. main.ts uses it to derive various values.
# Change this to point the agent at a new PRD.
PRD_SLUG=

# Docker image main.ts spawns the sandbox from.
# Build the image with `sandcastle docker build-image`.
IMAGE_NAME=
